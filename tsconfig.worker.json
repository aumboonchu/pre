{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["worker/**/*.ts", "worker-configuration.d.ts"]
}
