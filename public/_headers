# The SPA shell must always be fetched fresh so it references the current
# fingerprinted JavaScript and CSS files after a deployment.
/
  Cache-Control: no-store, max-age=0, must-revalidate

/index.html
  Cache-Control: no-store, max-age=0, must-revalidate

/login
  Cache-Control: no-store, max-age=0, must-revalidate

/branch
  Cache-Control: no-store, max-age=0, must-revalidate

/admin
  Cache-Control: no-store, max-age=0, must-revalidate

# Fingerprinted Vite assets are safe to cache permanently.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
